# ==========================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# JANGAN commit file `.env` yang berisi kredensial asli.
# ==========================================================

# --- Database MySQL ---
# Catatan: karakter khusus pada password harus di-encode.
# Contoh: password `Valrazor88@` -> `Valrazor88%40`
DATABASE_URL="mysql://root:Valrazor88%40@127.0.0.1:3306/laundry_db"

# Database khusus untuk menjalankan `npm test` (akan direset oleh test).
TEST_DATABASE_URL="mysql://root:Valrazor88%40@127.0.0.1:3306/laundry_db_test"

# --- Aplikasi ---
# Digunakan untuk membangun link detail pesanan pada notifikasi WhatsApp.
APP_URL="http://localhost:3000"

# Secret untuk menandatangani cookie session. Wajib diganti dengan nilai acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="ganti-dengan-nilai-acak-yang-panjang"

# --- WhatsApp Gateway (Fonnte) ---
# Token dari dashboard Fonnte. Hanya dipakai di server, jangan expose ke client.
FONNTE_TOKEN=""
# URL endpoint pengiriman Fonnte (biasanya tidak perlu diubah).
FONNTE_API_URL="https://api.fonnte.com/send"
# `true` = tidak mengirim request nyata ke Fonnte, hanya mencatat log simulasi.
# Gunakan `true` untuk development dan pengujian.
FONNTE_DRY_RUN="true"
# Batas waktu request ke Fonnte (milidetik).
FONNTE_TIMEOUT_MS="15000"

# --- Upload bukti transfer ---
# Ukuran maksimal file (MB) dan direktori penyimpanan privat.
MAX_UPLOAD_SIZE_MB="5"
UPLOAD_DIR="uploads"

# --- Akun admin dari proses seed ---
SEED_ADMIN_NAME="Admin Laundry"
SEED_ADMIN_EMAIL="admin@laundry.test"
SEED_ADMIN_PHONE="081200000001"
SEED_ADMIN_PASSWORD="Admin#12345"

# --- Akun pelanggan contoh dari proses seed ---
SEED_CUSTOMER_PASSWORD="Customer#12345"
